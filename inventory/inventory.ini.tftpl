# ============================================================
# Ansible Inventory Template for RKE2 Cluster
# ============================================================

[all]
rke2-cp-01 ansible_host={{ cp_ip }}
rke2-worker-01 ansible_host={{ worker_ip }}

[control_plane]
rke2-cp-01

[workers]
rke2-worker-01

[rke2_cluster:children]
control_plane
workers

[all:vars]
ansible_connection=ssh
ansible_user=ubuntu
ansible_become=true
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
ansible_ssh_private_key_file=~/.ssh/id_rsa
ansible_password=<parola>
