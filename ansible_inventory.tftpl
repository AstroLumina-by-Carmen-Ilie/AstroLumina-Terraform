[all]
rke2-cp-01
rke2-worker-01

[control_plane]
rke2-cp-01

[workers]
rke2-worker-01

[all:vars]
ansible_connection=local
ansible_user=ubuntu
ansible_become=true
# Pentru autentificare, folosește cheia publică sau parola
# ansible_ssh_private_key_file=~/.ssh/id_rsa
# ansible_password=<parola>

[rke2_control_plane]
rke2-cp-01 ansible_host=${cp_ip}

[rke2_workers]
rke2-worker-01 ansible_host=${worker_ip}